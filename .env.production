# Production build environment (used by `vite build`, e.g. on Netlify).
#
# The deployed frontend must call the DEPLOYED backend, never localhost.
# Vite gives `.env.production` precedence over `.env` for the production build,
# so local development keeps http://localhost:8082 from `.env` while the hosted
# build uses the deployed API.
VITE_APP_BASE_URL=https://ems-backend-d626.up.railway.app
